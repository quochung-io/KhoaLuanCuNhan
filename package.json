{
  "name": "ecc-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web-portal",
    "web-store"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently -n \"portal,store\" -c \"blue,magenta\" \"npm run web-portal:dev\" \"npm run web-store:dev\"",
    "web-portal:dev": "npm run dev --workspace=web-portal",
    "web-store:dev": "npm run dev --workspace=web-store"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
